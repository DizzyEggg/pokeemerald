script EventScript_BidoofNoPokemonTalk {
	lockall
	load_field_pic(FIELD_PIC_BIDOOF_NORMAL, 78, 107)
	msgbox("Hmmm? Are you surprised?")
	msgbox("We agreed to form a team.\nThat's true.")
	destroy_field_pic(FIELD_PIC_BIDOOF_NORMAL)
	load_field_pic(FIELD_PIC_BIDOOF_ASTONISHED, 78, 107)
	msgbox(format("But I'm not going to become one of your, so called, 'Party Members'! Especially not closed in that weird 'Poke Ball' thing!"))
	destroy_field_pic(FIELD_PIC_BIDOOF_ASTONISHED)
	setflag(FLAG_BIDOOF_NO_POKES_COMMENT)
	releaseall
	end
}

// Note: for Bidoof follower scripts always use var 0x8008 and 0x8009 for the mugshot id and 0x800A and 0x800B for sprite id

script EventScript_BidoofFollowerTypicalStart {
	lock
	faceplayer
	setvar(VAR_0x8008, 0xFF)
	setvar(VAR_0x8009, 0xFF)
	return
}

script EventScript_BidoofFollowerTypicalEnd {
	addvar(VAR_BIDOOF_FOLLOWER_NO_TALKS, 1)
	waitmessage
	if (var(VAR_0x8008) != 0xFF) {
		destroy_field_pic(VAR_0x8008, VAR_0x800A)
	}
	if (var(VAR_0x8009) != 0xFF) {
		destroy_field_pic(VAR_0x8009, VAR_0x800B)
	}
	return
}

script EventScript_BidoofFirstMsg {
	call(EventScript_BidoofFollowerTypicalStart)
	setvar(VAR_0x8008, FIELD_PIC_BIDOOF_NORMAL)
	load_field_pic(VAR_0x8008, 78, 107, VAR_0x800A)
	msgbox(format("Aren't you excited? The adventure is calling us!"))
	goto(EventScript_BidoofFollowerTypicalEnd)
}

script EventScript_BidoofFollowerTypicalMsg {
	call(EventScript_BidoofFollowerTypicalStart)
	setvar(VAR_0x8008, FIELD_PIC_BIDOOF_NORMAL)
	load_field_pic(VAR_0x8008, 78, 107, VAR_0x800A)
	random(7)
	switch (var(VAR_RESULT)) {
		case 0: msgbox("Let's continue.")
		case 1: msgbox("Let's go!")
		case 2: msgbox("Hmm? You want to take a break?")
		case 3: msgbox("This place is so weird...")
		case 4: msgbox("Lead the way.")
		case 5: msgbox("I've got your back.")
		case 6: msgbox("Yup!")
	}
	goto(EventScript_BidoofFollowerTypicalEnd)
}
