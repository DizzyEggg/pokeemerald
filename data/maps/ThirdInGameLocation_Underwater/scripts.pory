mapscripts ThirdInGameLocation_Underwater_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
	}
}

script ThirdInGameLocation_Bidoof3 {
	lock
	faceplayer
	if (var(VAR_HACK_GAME_STATE) == 1) {
		load_field_pic(FIELD_PIC_BIDOOF_UNEASY, 78, 107, VAR_0x8009)
		msgbox("Golly...")
		hide_field_pic(VAR_0x8009)
		load_field_pic(FIELD_PIC_BIDOOF_NORMAL, 78, 107, VAR_0x8008)
		msgbox("Hi.")
		hide_field_pic(VAR_0x8008)
		load_field_pic(FIELD_PIC_BIDOOF_ASTONISHED, 78, 107, VAR_0x800A)
		msgbox(format("I mean! You must be pretty surprised to see a Bidoof underwater! After all, ocean's depths are not my natural habitat."))
		hide_field_pic(VAR_0x800A)
		show_field_pic(VAR_0x8008)
		msgbox(format("It's weird, isn't it? Seeing a Bidoof here...A talking Bidoof at that!"))
		hide_field_pic(VAR_0x8008)
		show_field_pic(VAR_0x800A)
		msgbox(format("Though you don't look that surprised...Or you do? Golly, I can't tell!"))
		hide_field_pic(VAR_0x800A)
		show_field_pic(VAR_0x8008)
		msgbox(format("Sorry about earlier, running off like that. I was a bit scared when I saw you floating around there! But you seem like a nice chum."))
		msgbox(format("..."))
		msgbox(format("We need to get out of here. I don't know if you're aware, but there is a rock down there blocking the way."))
		hide_field_pic(VAR_0x8008)
		show_field_pic(VAR_0x800A)
		msgbox(format("You know, it's really weird how it's placed there, just like that. As if it was put on purpose...Though, I have to tell you, this whole place is so strange..."))
		msgbox(format("It's not natural at all...Well, it doesn't matter that much I guess! We need to get out of here!"))
		hide_field_pic(VAR_0x800A)
		show_field_pic(VAR_0x8008)
		msgbox(format("..."))
		hide_field_pic(VAR_0x8008)
		show_field_pic(VAR_0x8009)
		msgbox(format("The problem is...I have no idea how! I tried to break the rock myself, but as you can clearly see, it didn't work."))
		hide_field_pic(VAR_0x8009)
		show_field_pic(VAR_0x8008)
		msgbox(format("I'll rest a bit and try to think of a solution. In the meantime feel free to roam about, maybe you'll find something useful!"))
		destroy_field_pic(FIELD_PIC_BIDOOF_NORMAL, VAR_0x8008)
		destroy_field_pic(FIELD_PIC_BIDOOF_UNEASY, VAR_0x8009)
		destroy_field_pic(FIELD_PIC_BIDOOF_ASTONISHED, VAR_0x800A)
		addvar(VAR_HACK_GAME_STATE, 1)
		applymovement(5, MovementBidoof3)
		waitmovement(0)
		release
		end
	}
	elif (var(VAR_HACK_GAME_STATE) == 2) {
		load_field_pic(FIELD_PIC_BIDOOF_NORMAL, 78, 107, VAR_0x8008)
		msgbox("Hey pal, did you find something?", MSGBOX_YESNO)
		if (var(VAR_RESULT) == 1) {
			checkitem(ITEM_HM06)
			if (var(VAR_RESULT) == 1) {
				msgbox(format("Hm...Hidden machines...I know how these work!"))
				hide_field_pic(VAR_0x8008)
				load_field_pic(FIELD_PIC_BIDOOF_HAPPY, 78, 107, VAR_0x800A)
				msgbox(format("And it just so happens that I can learn this move!"))
				destroy_field_pic(FIELD_PIC_BIDOOF_HAPPY, VAR_0x800A)
				load_field_pic(FIELD_PIC_BIDOOF_SMIRKY, 78, 107, VAR_0x800A)
				msgbox(format("Let's get some rocks broken!"))
				destroy_field_pic(FIELD_PIC_BIDOOF_SMIRKY, VAR_0x800A)
				addvar(VAR_HACK_GAME_STATE, 1)
				closemessage
				specialvar(VAR_RESULT, GetPlayerFacingDirection)
				if (var(VAR_RESULT) == DIR_EAST) {
					applymovement(5, MovementBidoof_East)
					waitmovement(0)
					applymovement(OBJ_EVENT_ID_PLAYER, MovementPlayer_East)
					waitmovement(0)
				}
				else { // must be facing up
					applymovement(5, MovementBidoof_Up)
					waitmovement(0)
					applymovement(OBJ_EVENT_ID_PLAYER, MovementPlayer_Up)
					waitmovement(0)
				}
				applymovement(5, MovementBidoof_ToRockSmash)
				applymovement(OBJ_EVENT_ID_PLAYER, MovementPlayer_ToRockSmash)
				waitmovement(0)
				playse(SE_PC_LOGIN)
				msgbox("Bidoof learned {COLOR RED}Rock Smash{COLOR DARK_GRAY}!")
				msgbox("Bidoof used {COLOR RED}Rock Smash{COLOR DARK_GRAY}!")
				closemessage
				setvar(VAR_LAST_TALKED, 4)
				dofieldeffect(FLDEFF_USE_ROCK_SMASH)
				waitstate
				applymovement(VAR_LAST_TALKED, Movement_SmashRock)
				waitmovement(0)
				removeobject(VAR_LAST_TALKED)
				setflag(FLAG_HIDE_ROCK_SMASH_3RD_LOC)
				load_field_pic(FIELD_PIC_BIDOOF_HAPPY, 78, 107, VAR_0x800A)
				msgbox(format("And it's done! We make quite the team, huh?"))
				hide_field_pic(VAR_0x800A)
				show_field_pic(VAR_0x8008) // normal
				msgbox(format("You know, I think it'll be better if we hold together. At least, until we're out of here."))
				hide_field_pic(VAR_0x8008)
				load_field_pic(FIELD_PIC_BIDOOF_ASTONISHED, 78, 107, VAR_0x800B)
				msgbox(format("Who knows whatever may loom here..."))
				hide_field_pic(VAR_0x800B)
				show_field_pic(VAR_0x8008) // normal
				msgbox("I hope you agree with me, {PLAYER}!", MSGBOX_YESNO)
				if (var(VAR_RESULT) != 1) {
					do {
						hide_field_pic(VAR_0x8008)
						show_field_pic(VAR_0x800B) // astonished
						msgbox("Golly, you can't be serious!\n")
						hide_field_pic(VAR_0x800B)
						show_field_pic(VAR_0x8008)
						msgbox("Let's get out of here together, {PLAYER}!", MSGBOX_YESNO)
					} while (var(VAR_RESULT) != 1)
					hide_field_pic(VAR_0x8008)
					show_field_pic(VAR_0x800B) // astonished
					msgbox("Golly, please do not joke like that!")
					hide_field_pic(VAR_0x800B)
				}
				show_field_pic(VAR_0x8008) // normal
				msgbox(format("Alright! Take the lead, {PLAYER}. I'll be right behind you."))
				setflag(FLAG_HIDE_BIDOOF_3)
				setflag(FLAG_BIDOOF_FOLLOWER)
				removeobject(5)
				destroy_field_pic(FIELD_PIC_BIDOOF_NORMAL, VAR_0x8008)
				destroy_field_pic(FIELD_PIC_BIDOOF_HAPPY, VAR_0x800A)
				destroy_field_pic(FIELD_PIC_BIDOOF_ASTONISHED, VAR_0x800B)
				release
				end
			}
			else {
				hide_field_pic(VAR_0x8008)
				load_field_pic(FIELD_PIC_BIDOOF_ASTONISHED, 78, 107, VAR_0x800A)
				msgbox("Golly! I'm not convinced...")
				destroy_field_pic(FIELD_PIC_BIDOOF_UNEASY, VAR_0x800A)
			}
		}
		else {
			hide_field_pic(VAR_0x8008)
			load_field_pic(FIELD_PIC_BIDOOF_HAPPY, 78, 107, VAR_0x800A)
			msgbox("No worries!" I'm sure we'll find some way out of here!)
			destroy_field_pic(FIELD_PIC_BIDOOF_HAPPY, VAR_0x800A)
		}
		destroy_field_pic(FIELD_PIC_BIDOOF_NORMAL, VAR_0x8008)
		applymovement(5, MovementBidoof3)
		waitmovement(0)
	}
	release
	end
}

movement MovementBidoof_ToRockSmash {
	walk_left
	walk_left
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	step_end
}

movement MovementPlayer_ToRockSmash {
	walk_left
	walk_left
	walk_left
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	step_end
}

movement MovementBidoof_East {
	walk_down
	walk_left
	walk_left
	step_end
}

movement MovementPlayer_East {
	walk_down
	step_end
}

movement MovementBidoof_Up {
	walk_left
	walk_down
	walk_left
	step_end
}

movement MovementPlayer_Up {
	walk_left
	step_end
}

movement MovementBidoof3 {
	face_right
	step_end
}

script ThirdInGameLocation_Underwater_RockSmash {
	lock
	checkitem(ITEM_HM06)
	if (var(VAR_RESULT) == 1) {
		msgbox(format("It's a rugged rock blocking the way. Pokemon knowing the move {COLOR RED}Rock Smash{COLOR DARK_GRAY} could smash it."))
	}
	else {
		msgbox("It's a rugged rock blocking the way.\nThere must be a way to smash it somehow...")
	}
	release
	end
}

script ThirdInGameLocation_Underwater_BidoffTrigger2 {
	lock
	playse(SE_PIN)
	setflag(FLAG_HIDE_BIDOOF_2)
	applymovement(3, MovementBidoof2)
	waitmovement(0)
	removeobject(3)
	release
	end
}

movement MovementBidoof2 {
	walk_up
	walk_up
	emote_double_exclamation_mark
	delay_16
	delay_4
	face_down
	delay_8
	walk_down
	walk_down
	walk_down
	set_invisible
	step_end
}

script ThirdInGameLocation_Underwater_BidoffTrigger1 {
	lock
	playse(SE_PIN)
	setflag(FLAG_HIDE_BIDOOF_1)
	applymovement(2, MovementBidoof1)
	waitmovement(0)
	removeobject(2)
	release
	end
}

movement MovementBidoof1 {
	emote_double_exclamation_mark
	delay_16
	delay_4
	face_right
	delay_8
	walk_right
	walk_right
	set_invisible
	step_end
}

script ThirdInGameLocation_Underwater_CreepyHexManiac {
	lock
	setvar(VAR_LAST_TALKED, 1) // 1 being Hex Maniac local id
	setvar(VAR_0x8004, RGB_WHITEALPHA)
	setvar(VAR_0x8005, 7)
	callnative(BlendTalkingObj)
	applymovement(VAR_LAST_TALKED, MovementHexManiac1)
	waitmovement(0)
	setvar(VAR_0x8005, 13)
	callnative(BlendTalkingObj)
	playmoncry(ADDED_SOUND_FEMALE_LAUGH_1, CRY_MODE_NORMAL)
	applymovement(VAR_LAST_TALKED, MovementHexManiac2)
	waitmovement(0)
	setflag(FLAG_HEX_MANIAC_GONE)
	release
	end
}

movement MovementHexManiac1 {
	jump_2_down
	delay_2
	walk_in_place_slow_down
	walk_slow_down
	walk_in_place_slow_down
	delay_1
	step_end
}

movement MovementHexManiac2 {
	walk_in_place_fast_down
	walk_in_place_fast_down
	delay_4
	walk_faster_down
	walk_faster_down
	walk_faster_down
	set_invisible
	step_end
}
