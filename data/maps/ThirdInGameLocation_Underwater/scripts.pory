mapscripts ThirdInGameLocation_Underwater_MapScripts {
	// Hide cave openings
	MAP_SCRIPT_ON_LOAD {
		if (flag(FLAG_CAVE_DOOR_PUZZLE_DONE) != TRUE) {
			setmetatile(32, 72, METATILE_Underwater_RockWall, TRUE)
			setmetatile(32, 71, METATILE_Underwater_RockWall, TRUE)
		} else {
			// Hide 'fake' rock switch to a normal rock
			setmetatile(54, 75, 0x22F, TRUE)
		}
	}
	MAP_SCRIPT_ON_TRANSITION {
		if (var(VAR_HACK_GAME_STATE) == 10) { // after Suicune encounter, before defeating him
			setobjectxyperm(8, 26, 2)
		}
	}
	MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, VAR_VALUE_GOT_KOED: ThirdInGameLocation_Underwater_GotKOedByWild
    ]
}

script ThirdInGameLocation_Underwater_GotKOedByWild {
	lock
	special(HealPlayerParty)
	msgbox_portrait(format("Golly, {PLAYER}! Your Pokemon fainted!"), FIELD_PIC_BIDOOF_ASTONISHED)
	msgbox_portrait(format("I'll heal your Party, but you need to be more careful the next time!"), FIELD_PIC_BIDOOF_NORMAL)
	setvar(VAR_TEMP_0, 0)
	release
	end
}

script ThirdInGameLocation_Underwater_EscapeTrigger {
	lock
	msgbox_portrait(format("Do you really want to leave, {PLAYER}?"), FIELD_PIC_BIDOOF_NORMAL, MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		msgbox_portrait("Golly, I'm really nervous about it!\pWelp!", FIELD_PIC_BIDOOF_ASTONISHED)
		warpteleport(MAP_DARKNESS_TRANSITION_MAP, 9, 76)
	} else {
		closemessage
		applymovement(OBJ_EVENT_ID_PLAYER, Movement_PlayerStepBack)
		waitmovement(0)
		msgbox_portrait(format("You're right, let's prepare ourselves first!"), FIELD_PIC_BIDOOF_NORMAL)
	}
	release
	end
}

movement Movement_PlayerStepBack {
	walk_down
	walk_left
	step_end
}

script ThirdInGameLocation_Underwater_SuicuneBattle {
	lock
	faceplayer
	msgbox_portrait(format("Do you wish to battle me?"), FIELD_PIC_SUICUNE, MSGBOX_YESNO)
	if (var(VAR_RESULT) == YES) {
		playmoncry(SPECIES_SUICUNE, CRY_MODE_NORMAL)
		msgbox_portrait(format("Here I come!"), FIELD_PIC_SUICUNE)
		closemessage
		setwildbattle(SPECIES_SUICUNE, 862)
		dowildbattle
		getbyte(gBattleOutcome, VAR_RESULT)
		if (var(VAR_RESULT) == B_OUTCOME_LOST) {
			msgbox_portrait(format("Not yet! Come back when you're better prepeared."), FIELD_PIC_SUICUNE)
			msgbox_portrait(format("You can't give up now, {PLAYER}!\pThere must be some way to defeat him, I believe in you!"), FIELD_PIC_BIDOOF_NORMAL)
			special(HealPlayerParty)
		} else {
			setvar(VAR_HACK_GAME_STATE, 11)
			msgbox_portrait(format("Splendid!\pI admit my defeat. Please take this as a proof of overcoming this challenge."), FIELD_PIC_SUICUNE)
			message("{PLAYER} received the Suicune Badge.")
			waitmessage
			call(Common_EventScript_PlayGymBadgeFanfare)
			setflag(FLAG_BADGE03_GET)
			msgbox_portrait(format("Wow! You're rocking it, {PLAYER}!"), FIELD_PIC_BIDOOF_HAPPY)
			msgbox_portrait(format("As I promised earlier, you are free to leave this place. However, let me warn you. I cannot guarantee you'll be able to return here. The things you will experience from now on, are nothing like you have ever seen before. This world may already seem beyond repair, but it gets worse.\pBidoof."), FIELD_PIC_SUICUNE)
			msgbox_portrait("Golly, what!", FIELD_PIC_BIDOOF_ASTONISHED)
			msgbox_portrait(format("I hope you are aware of the dangers, and know what you are doing."), FIELD_PIC_SUICUNE)
			msgbox_portrait(format("I have absolutely no idea what you're referring to!"), FIELD_PIC_BIDOOF_ASTONISHED)
			msgbox_portrait(format("I'll take that as a yes. That was my final warning. Proceed with caution.\p{PLAYER}.\pBidoof.\pAu revoir."), FIELD_PIC_SUICUNE)
			closemessage
			callnative(ScrCmd_PlayBattleTransition)
			waitstate
			msgbox_portrait(format("Wow, that was certainly something!\pHe did sound serious though...I have no idea what awaits us once we leave this place, {PLAYER}. Let's prepare ourselves for the worst. As Suicune said, I have no idea if we'll be able to go back. Make sure to equip everything you think could be useful in the future. Once you're ready, let's go!"), FIELD_PIC_BIDOOF_NORMAL)
		}
	}
	release
	end
}

script ThirdInGameLocation_Underwater_SuicuneTrigger {
	lock
	fadeoutbgm(1)
	playse(SE_DOWNPOUR)
	callnative(ScrCmd_PlayBattleTransition)
	waitstate
	playse(SE_DOWNPOUR_STOP)
	fadeinbgm(2)
	applymovement(8, MovementSuicuneJump)
	waitmovement(0)
	setobjectxyperm(8, 26, 2)
	applymovement(OBJ_EVENT_ID_PLAYER, MovementExclamationMark)
	applymovement(OBJ_EVENT_ID_FOLLOWER, MovementExclamationMark)
	waitmovement(0)
	msgbox_portrait("Golly!", FIELD_PIC_BIDOOF_ASTONISHED)
	msgbox_portrait(format("It is a pleasure to finally meet you, {PLAYER}!\pYou too Bidoof, it has been a while since the last time."), FIELD_PIC_SUICUNE)
	msgbox_portrait(format("Is this the legendary Suicune?!"), FIELD_PIC_BIDOOF_ASTONISHED)
	msgbox_portrait(format("The guardian's role has been assigned to me, and I'll do my best to fulfill it.\pI will not let you pass, until you have proved your worth to me. You see, this distorted world has given me an immense power, I feel stronger than ever. As such, this trial will pertain to your craftiness. In order to defeat me in a battle, you will need to think outside the box, to come up with non-standard solutions."), FIELD_PIC_SUICUNE)
	msgbox_portrait(format("Golly, sounds scary!"), FIELD_PIC_BIDOOF_ASTONISHED)
	msgbox_portrait(format("There is nothing scary about it, Bidoof. You and I both know this. In fact, if there is anything you should be scared about, it's triumphing over me and passing through that door.\pNonetheless, I'll be waiting for you here. Whenever you feel ready, I'll take on your challenge."), FIELD_PIC_SUICUNE)
	msgbox_portrait(format("Hmm, this looks different than what we have faced before! Be careful, {PLAYER}! It probably won't be as easy as that Hiker's battle.\pIn any case, let's do our best!"), FIELD_PIC_BIDOOF_NORMAL)
	setflag(FLAG_SUICUNE_TRIGGER_DONE)
	setvar(VAR_HACK_GAME_STATE, 10)
	release
	end
}

movement MovementSuicuneJump {
	jump_up
	walk_left
	face_down
	step_end
}

movement MovementExclamationMark {
	emote_exclamation_mark
	step_end
}

script ThirdInGameLocation_Underwater_WildMonsSoon_Down {
	lock
	applymovement(OBJ_EVENT_ID_PLAYER, MovementJustFaceDown)
	goto(ThirdInGameLocation_Underwater_WildMonsSoon)
}

script ThirdInGameLocation_Underwater_WildMonsSoon_Left {
	lock
	applymovement(OBJ_EVENT_ID_PLAYER, MovementJustFaceLeft)
	goto(ThirdInGameLocation_Underwater_WildMonsSoon)
}

script ThirdInGameLocation_Underwater_WildMonsSoon {
	waitmovement(0)
	setvar(VAR_HACK_GAME_STATE, 7)
	msgbox_portrait(format("Hey, {PLAYER}! There's long grass ahead. Do you know what it means? Well, it means that it's dangerous to go there without a Pokemon!"), FIELD_PIC_BIDOOF_NORMAL)
	msgbox_portrait(format("Golly, don't give me that look! I'm too weak to handle all of these by my own!"), FIELD_PIC_BIDOOF_ASTONISHED)
	msgbox_portrait(format("But don't you worry, chum. I've got a plan!\pListen carefully!\pI'll give you one of these Poke Balls, you'll use it to capture the wild Pokemon, and then we'll be able to cross the grass! Clever, isn't it?"), FIELD_PIC_BIDOOF_NORMAL)
	msgbox_portrait(format("Uhm? Where did I get the Poke Ball from?"), FIELD_PIC_BIDOOF_NORMAL)
	msgbox_portrait(format("Well, sometimes it's better not to know everything!"), FIELD_PIC_BIDOOF_ASTONISHED)
	msgbox_portrait(format("So, what do you say? Are you in?"), FIELD_PIC_BIDOOF_NORMAL)
	dynmultichoice(0, 5, TRUE, 1, 0, DYN_MULTICHOICE_CB_NONE, "What if it doesn't get caught?")
	msgbox_portrait(format("No worries! I've already taken that into account. Remember how we blended berries with Wingull? You actually got a {POKEBLOCK}, which can be fed to Pokemon! That'll make it easier to catch!"), FIELD_PIC_BIDOOF_NORMAL)
	msgbox_portrait(format("Alright, let's go!"), FIELD_PIC_BIDOOF_NORMAL)
	waitmessage
	closemessage
	applymovement(OBJ_EVENT_ID_PLAYER, MovementPlayerIntoGrass)
	waitmovement(0)
	// We'll use safari zone's mode for catching
	setflag(FLAG_SYS_SAFARI_MODE)
	setbyte(gNumSafariBalls, 1)
	setwildbattle(SPECIES_CHINCHOU, 35)
	dowildbattle
	clearflag(FLAG_SYS_SAFARI_MODE)
	msgbox_portrait(format("Nicely done, {PLAYER}! You've just caught your very first Pokemon! I certainly hope it won't be your last!"), FIELD_PIC_BIDOOF_HAPPY)
	msgbox_portrait(format("Alright {PLAYER}, I believe we can go into the long grass without worrying about wild Pokemon. Let's continue ahead."), FIELD_PIC_BIDOOF_NORMAL)
	setvar(VAR_HACK_GAME_STATE, 8)
	release
	end
}

movement MovementJustFaceDown {
	face_down
	step_end
}

movement MovementJustFaceLeft {
	face_left
	step_end
}

movement MovementPlayerIntoGrass {
	walk_up
	walk_right * 3
	jump_in_place_up_down
	jump_in_place_right_left
	jump_in_place_up_down
	jump_in_place_right_left
	step_end
}

script ThirdInGameLocation_Underwater_PsychicGuru {
	lock
	faceplayer
	if (flag(FLAG_PSYHIC_GURU_TALKED_WITH) != TRUE) {
		msgbox("Y{PAUSE 15}-O{PAUSE 25}-U!")
		msgbox(format("Yes, you two! Do not be timid! Welcome in my domain - the forest!"))
		msgbox_portrait("Forest? We're underwater...", FIELD_PIC_BIDOOF_UNEASY)
		msgbox(format("YES! The trees are my servants, look at their majestic movements. Observe how they gracely dance with the wind!\nYes, yes, do you hear them talking?"))
		msgbox("Listen closely!")
		msgbox("V2UncmUgcm9ja3MsIG5vdCB0cmVlcy\n4gV2UncmUgdW5kZXJ3YXRlciBhbmQg\lbm90IGluc2lkZSBhIGZvcmVzdC4gQW\l5kIHRoaXMgZ3V5IGlzIGEgZnUqKmluZy\lBtb3JvbiwgZG9uJ3QgbGlzdGVuIHRv\lIGhpbSB+IHNpbmNlcmVseSwgd\lGhlIHJvY2tzLg==")
		msgbox("Aren't they magnificent?")
		waitmessage
		closemessage
		delay(29)
		msgbox_portrait(format("Psst! {PLAYER}!\pI don't think this person is going to help us much...\pLet's leave and go our way."), FIELD_PIC_BIDOOF_NORMAL)
		setflag(FLAG_PSYHIC_GURU_TALKED_WITH)
	} else {
		msgbox("I take good care of my servants.")
	}
	release
	end
}

script ThirdInGameLocation_Underwater_ActivateRockSwitch {
	lock
	if (flag(FLAG_CAVE_DOOR_PUZZLE_DONE) != TRUE) {
		playse(SE_NOTE_G)
		waitse
		playse(SE_NOTE_F)
		waitse
		playse(SE_NOTE_E)
		waitse
		playse(SE_NOTE_D)
		waitse
		playse(SE_NOTE_C)
		waitse
		playse(SE_NOTE_G)
		waitse
		playse(SE_NOTE_G)
		waitse
		playse(SE_NOTE_C)
		waitse
		playse(SE_CLICK)
		waitse
		setflag(FLAG_CAVE_DOOR_PUZZLE_DONE)
		setflag(FLAG_HIDE_WINGULL)
		setmetatile(32, 72, 0x22E, FALSE) // Doors
		setmetatile(32, 71, 0x226, FALSE) // Doors
		setmetatile(54, 75, 0x22F, TRUE)
		special(DrawWholeMapView)
		msgbox_portrait("Golly!\pI think you did something...", FIELD_PIC_BIDOOF_ASTONISHED)
		msgbox_portrait("Let's see what's changed.", FIELD_PIC_BIDOOF_NORMAL)
	} else {
		msgbox("It is already activated.")
	}
	release
	end
}

script ThirdInGameLocation_Underwater_SeemsTheWayIsBlockedTrigger {
	lock
	if (flag(FLAG_CAVE_DOOR_PUZZLE_DONE) != TRUE) { // The Bidoof dialogue doesn't happen if the switch is already activated.
		msgbox_portrait("Hm...", FIELD_PIC_BIDOOF_NORMAL)
		closemessage
		applymovement(OBJ_EVENT_ID_PLAYER, Movement_SeeNoWay)
		waitmovement(0)
		msgbox_portrait(format("It seems the way is blocked\nby these rocks.\pI don't think I'll be able to smash these by myself. Let's try to find some other way to get past them."), FIELD_PIC_BIDOOF_NORMAL)
	}
	setflag(FLAG_TRIGGER_3RD_MAP_SEEMS_NO_WAY)
	release
	end
}

movement Movement_SeeNoWay {
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	step_end
}

script ThirdInGameLocation_Bidoof3 {
	lock
	faceplayer
	if (var(VAR_HACK_GAME_STATE) == 1) {
		msgbox_portrait("Golly...", FIELD_PIC_BIDOOF_UNEASY)
		msgbox_portrait("Hi.", FIELD_PIC_BIDOOF_NORMAL)
		msgbox_portrait(format("I mean! You must be pretty surprised to see a Bidoof underwater! After all, ocean's depths are not my natural habitat."), FIELD_PIC_BIDOOF_ASTONISHED)
		msgbox_portrait(format("It's weird, isn't it? Seeing a Bidoof here...A talking Bidoof at that!"), FIELD_PIC_BIDOOF_NORMAL)
		msgbox_portrait(format("Though you don't look that surprised...Or you do? Golly, I can't tell!"), FIELD_PIC_BIDOOF_ASTONISHED)
		msgbox_portrait(format("Sorry about earlier, running off like that. I was a bit scared when I saw you floating around there! But you seem like a nice chum.\p...\pWe need to get out of here. I don't know if you're aware, but there is a rock down there blocking the way."), FIELD_PIC_BIDOOF_NORMAL)
		msgbox_portrait(format("You know, it's really weird how it's placed there, just like that. As if it was put on purpose...Though, I have to tell you, this whole place is so strange...\pIt's not natural at all...Well, it doesn't matter that much I guess! We need to get out of here!"), FIELD_PIC_BIDOOF_ASTONISHED)
		msgbox_portrait(format("..."), FIELD_PIC_BIDOOF_NORMAL)
		msgbox_portrait(format("The problem is...I have no idea how! I tried to break the rock myself, but as you can clearly see, it didn't work."), FIELD_PIC_BIDOOF_UNEASY)
		msgbox_portrait(format("I'll rest a bit and try to think of a solution. In the meantime feel free to roam about, maybe you'll find something useful!"), FIELD_PIC_BIDOOF_NORMAL)
		addvar(VAR_HACK_GAME_STATE, 1)
		applymovement(5, MovementBidoof3)
		waitmovement(0)
		release
		end
	}
	elif (var(VAR_HACK_GAME_STATE) == 2) {
		msgbox_portrait("Hey pal, did you find something?", FIELD_PIC_BIDOOF_NORMAL, MSGBOX_YESNO)
		if (var(VAR_RESULT) == 1) {
			checkitem(ITEM_HM06)
			if (var(VAR_RESULT) == 1) {
				msgbox_portrait(format("Hm...Hidden machines...I know how these work!"), FIELD_PIC_BIDOOF_NORMAL)
				msgbox_portrait(format("And it just so happens that I can learn this move!"), FIELD_PIC_BIDOOF_HAPPY)
				msgbox_portrait(format("Let's get some rocks broken!"), FIELD_PIC_BIDOOF_SMIRKY)
				addvar(VAR_HACK_GAME_STATE, 1)
				closemessage
				specialvar(VAR_RESULT, GetPlayerFacingDirection)
				if (var(VAR_RESULT) == DIR_EAST) {
					applymovement(5, MovementBidoof_East)
					waitmovement(0)
					applymovement(OBJ_EVENT_ID_PLAYER, MovementPlayer_East)
					waitmovement(0)
				}
				else { // must be facing up
					applymovement(5, MovementBidoof_Up)
					waitmovement(0)
					applymovement(OBJ_EVENT_ID_PLAYER, MovementPlayer_Up)
					waitmovement(0)
				}
				applymovement(5, MovementBidoof_ToRockSmash)
				applymovement(OBJ_EVENT_ID_PLAYER, MovementPlayer_ToRockSmash)
				waitmovement(0)
				playse(SE_PC_LOGIN)
				msgbox("Bidoof learned {COLOR RED}Rock Smash{COLOR DARK_GRAY}!")
				msgbox("Bidoof used {COLOR RED}Rock Smash{COLOR DARK_GRAY}!")
				closemessage
				setvar(VAR_LAST_TALKED, 4)
				dofieldeffect(FLDEFF_USE_ROCK_SMASH)
				waitstate
				applymovement(VAR_LAST_TALKED, Movement_SmashRock)
				waitmovement(0)
				removeobject(VAR_LAST_TALKED)
				setflag(FLAG_HIDE_ROCK_SMASH_3RD_LOC)
				msgbox_portrait(format("And it's done! We make quite the team, huh?"), FIELD_PIC_BIDOOF_HAPPY)
				msgbox_portrait(format("You know, I think it'll be better if we hold together. At least, until we're out of here."), FIELD_PIC_BIDOOF_NORMAL)
				msgbox_portrait(format("Who knows whatever may loom here..."), FIELD_PIC_BIDOOF_ASTONISHED)
				msgbox_portrait("I hope you agree with me, {PLAYER}!", FIELD_PIC_BIDOOF_NORMAL, MSGBOX_YESNO)
				if (var(VAR_RESULT) != 1) {
					do {
						msgbox_portrait("Golly, you can't be serious!\n", FIELD_PIC_BIDOOF_ASTONISHED)
						msgbox_portrait("Let's get out of here together, {PLAYER}!", FIELD_PIC_BIDOOF_NORMAL, MSGBOX_YESNO)
					} while (var(VAR_RESULT) != 1)
					msgbox_portrait("Golly, please do not joke like that!", FIELD_PIC_BIDOOF_ASTONISHED)
				}
				msgbox_portrait(format("Alright! Take the lead, {PLAYER}. I'll be right behind you."), FIELD_PIC_BIDOOF_HAPPY)
				closemessage
				setflag(FLAG_HIDE_BIDOOF_3)
				setflag(FLAG_BIDOOF_FOLLOWER)
				setflag(FLAG_SYS_POKEMON_GET) // Pokemon menu can be opened, tho no pokemon in party
				removeobject(5)
				delay(2)
				callnative(UpdateFollowingPokemon)
				delay(2)
				applymovement(OBJ_EVENT_ID_PLAYER, MovementPlayerDown)
				waitmovement(0)
				release
				end
			}
			else {
				msgbox_portrait("Golly! I'm not convinced...", FIELD_PIC_BIDOOF_ASTONISHED)
			}
		}
		else {
			msgbox_portrait(format("No worries! I'm sure we'll find some way out of here!"), FIELD_PIC_BIDOOF_HAPPY)
		}
		applymovement(5, MovementBidoof3)
		waitmovement(0)
	}
	release
	end
}

movement MovementPlayerDown {
	walk_down
	step_end
}

movement MovementBidoof_ToRockSmash {
	walk_left
	walk_left
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	step_end
}

movement MovementPlayer_ToRockSmash {
	walk_left
	walk_left
	walk_left
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	step_end
}

