mapscripts MapFifthLeader_MapScripts {}

script Script_HackFifthLeader {
	lockall
	setvar(VAR_0x8004, PC_LOCATION_OTHER)
	special(DoPCTurnOnEffect)
	playse(SE_PC_ON)
	if (flag(FLAG_FIFTH_LEADER_BEATEN) != TRUE) {
		if (flag(FLAG_FIFTH_EXPLAINED) == TRUE) {
		Script_HackFifthLeader_StartChallengeAsk:
			msgbox("Are you ready?", MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				special(SavePlayerParty)
				callnative(ChooseMonsForPCChallenge)
				waitstate
				setflag(B_FLAG_AI_VS_AI_BATTLE)
				trainerbattle_no_intro(TRAINER_ROTOM_PC_CHALLENGE, "Wow, you did it!")
				clearflag(B_FLAG_AI_VS_AI_BATTLE)
				special(LoadPlayerParty)
				getbyte(gBattleOutcome, VAR_RESULT)
				if (var(VAR_RESULT) == B_OUTCOME_LOST) {
					msgbox(format("Won't be that easy, hm? Try to think of a better team next time!"))
				}
				else {
					msgbox(format("Awesome work!"))
					setflag(FLAG_FIFTH_LEADER_BEATEN)
					message("{PLAYER} received the Fifth Badge!")
					waitmessage
					call(Common_EventScript_PlayGymBadgeFanfare)
					msgbox(format("Now that you've completed my challenge, I won't keep you here any longer. You're free to go.\pMy work here is done.\pOr is it?"))
					setwildbattle(SPECIES_ROTOM, 50)
					dowildbattle
					if (var(VAR_RESULT) != B_OUTCOME_CAUGHT) {
						msgbox_portrait(format("Well, now I'm really done. It was nice seeing you!"), FIELD_PIC_ROTOM)
						fadescreen(FADE_TO_BLACK)
						delay(3)
						fadescreen(FADE_FROM_BLACK)
						delay(3)
					}
					else {
						setflag(FLAG_ROTOM_CAUGHT)
					}
					setvar(VAR_HACK_GAME_STATE, 17)
					msgbox(format("Thank you for playing Pokemon Emerald Underwater! The first part of the Story ends here. What happened with Bidoof? And what with the remaining Badges? Find out in the next update!"))
					special(SaveGame)
					special(DoSoftReset)
				}
			}
		}
		else {
			msgbox(Text_BootUpPC, MSGBOX_DEFAULT)
			msgbox(format("…\pHey! Don't turn me on like that!\pAnyway, welcome challenger! I am the first…no, not first. Fifth…I think! I am the fifth gym leader! In order to proceed, you will need to defeat me. However! We won't have a regular battle like usual. We'll have a…hmm special kind of battle I guess. Let me explain…\pSo…\pUgh, I'm not good with explaining. You know what? Screw the script. Basically, he wanted to me to be some sort of a 'cheater' challenge, but with a twist. The twist being that it'll be ME controlling your Pokemon! Cool stuff, huh? I'm sure you were NOT expecting this! And that's not all! You will be able to choose almost ANY Pokemon in this challenge!\pWhere's the catch? Well, your team will be against 3 legendaries, {COLOR BLUE}Kyogre{COLOR DARK_GRAY}, {COLOR RED}Groudon{COLOR DARK_GRAY} and {COLOR GREEN}Rayquaza{COLOR DARK_GRAY}. Oh, and you cannot choose neither legendary nor mythical Pokemon.\pHmm? You're saying it's not fair? Well, who told you it was even supposed to be fair! Uff, that's some wall of text you've just had to read, huh?"))
			msgbox(format("Don't worry, I'm finished. You can choose your Pokemon and we can start the challenge!"))
			setflag(FLAG_FIFTH_EXPLAINED)
			goto(Script_HackFifthLeader_StartChallengeAsk)
		}
	}
	else {
		msgbox("This PC is not functioning anymore…")
	}
	playse(SE_PC_OFF)
	special(DoPCTurnOffEffect)
	releaseall
	end
}