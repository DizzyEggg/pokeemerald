mapscripts SecondChallengeRoom_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if (flag(FLAG_HIKER_CHALLENGE_DONE) != TRUE) {
			setobjectxyperm(1, 6, 4)
			turnobject(1, DIR_SOUTH)
		}
	}
	
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_HACK_GAME_STATE, 8: SecondChallengeRoom_FirstBidoofMsg
	]
}

script SecondChallengeRoom_Hiker {
	lock
	faceplayer
	if (flag(FLAG_HIKER_CHALLENGE_DONE) != TRUE) {
		if (flag(FLAG_HIKER_FIRST_ENCOUNTER_DONE) != TRUE) {
			msgbox(format("Yo. Listen, I'll make it short for all of us. As you may have already guessed, I am the second leader here. And I can't let you pass, until you beat me. I hope I've made myself clear."))
			load_field_pic(FIELD_PIC_BIDOOF_NORMAL, 33, 107, VAR_0x8008)
			msgbox_pic(format("Be careful {PLAYER}. We don't know what we'll need to do in order to get past him."), VAR_0x8008)
			msgbox(format("You just need to beat me in a battle, pal. Simple as that."))
			msgbox_pic(format("Oh, it looks like it'll be simpler this time around then."), VAR_0x8008)
			load_field_pic(FIELD_PIC_BIDOOF_SMIRKY, 33, 107, VAR_0x800A)
			msgbox_pic(format("Let's beat this guy, {PLAYER}!"), VAR_0x800A)
			setflag(FLAG_HIKER_FIRST_ENCOUNTER_DONE)
			destroy_field_pic(FIELD_PIC_BIDOOF_NORMAL, VAR_0x8008)
			destroy_field_pic(FIELD_PIC_BIDOOF_SMIRKY, VAR_0x800A)
			goto(SecondChallengeRoom_HikerBattle)
		} else {
			msgbox("It's you again.")
			msgbox("You wanna try one more time?", MSGBOX_YESNO)
			if (var(VAR_RESULT) == 1) {
				goto(SecondChallengeRoom_HikerBattle)
			}
		}
	} 
	else {
		msgbox(format("Good luck on your journey, you'll need it."))
	}
	release
	end
}

script SecondChallengeRoom_HikerBattle {
	trainerbattle_no_intro(TRAINER_HIKER_CHALLENGE, 0)
	getbyte(gBattleOutcome, VAR_RESULT)
	if (var(VAR_RESULT) == B_OUTCOME_LOST) {
		msgbox("You lost, punk.")
		msgbox(format("You need stronger Pokemon, if you want to defeat me."))
		load_field_pic(FIELD_PIC_BIDOOF_NORMAL, 33, 107, VAR_0x8008)
		msgbox_pic(format("Ow...Don't worry, {PLAYER}! I'm sure you'll beat this guy. Look around the place, try to find new Pokemon and come with a better plan next time!"), VAR_0x8008)
		msgbox_pic(format("For now, let's get your Party members healed."), VAR_0x8008)
		waitmessage
		closemessage
		special(HealPlayerParty)
		// Todo: follower 
		getplayerxy(VAR_0x8004, VAR_0x8005)
		if (var(VAR_0x8004) == 7 && var(VAR_0x8005) == 4) {
			applymovement(OBJ_EVENT_ID_PLAYER, Movement_PlayerToNurse3)
		} elif (var(VAR_0x8004) == 5 && var(VAR_0x8005) == 4) {
			applymovement(OBJ_EVENT_ID_PLAYER, Movement_PlayerToNurse2)
		} else {
			applymovement(OBJ_EVENT_ID_PLAYER, Movement_PlayerToNurse1)
		}
		delay(10)
		waitmovement(0)
		playfanfare(FANFARE_HEAL)
		msgbox_pic(format("I'll give you a tip, {PLAYER}. Check out the area south from here. I'm sure you'll be be able to train and catch new Pokemon there. Courage!"), VAR_0x8008)
		destroy_field_pic(FIELD_PIC_BIDOOF_NORMAL, VAR_0x8008)
	} else {
		msgbox("NANI?!")
		setflag(FLAG_HIKER_CHALLENGE_DONE)
	}
	release
	end
}

movement Movement_PlayerToNurse1 {
	walk_down * 8
	walk_right
	walk_down * 3
	walk_left * 3
	walk_up
	walk_left * 2
	step_end
}

movement Movement_PlayerToNurse2 {
	walk_down * 9
	walk_right * 2
	walk_down * 3
	walk_left * 3
	walk_up
	walk_left * 2
	step_end
}

movement Movement_PlayerToNurse3 {
	walk_down * 12
	walk_left * 3
	walk_up
	walk_left * 2
	step_end
}

script SecondChallengeRoom_FirstBidoofMsg {
	lock
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Up)
	waitmovement(0)
	load_field_pic(FIELD_PIC_BIDOOF_NORMAL, 33, 107, VAR_0x8008)
	msgbox(format("Looks like we've entered another transition cave. And this time, it is actually a cave. Let's keep our eyes open. Who knows what we'll find here."))
	setvar(VAR_HACK_GAME_STATE, 9)
	waitmessage
	closemessage
	destroy_field_pic(FIELD_PIC_BIDOOF_NORMAL, VAR_0x8008)
	release
	end
}

script SecondChallengeRoom_NurseJoy {
	lock
	faceplayer
	msgbox(format("I'll heal your Pokemon."))
	playfanfare(FANFARE_HEAL)
	special(HealPlayerParty)
	applymovement(2, Movement_PkmnCenterNurse_Bow)
	waitmovement(0)
	waitmessage
	waitfanfare
	release
	end
}

script SecondChallengeRoom_MartGuy {
	lock
	faceplayer
	message("I sell items.")
	waitmessage
	pokemart(SecondChallengeRoom_Mart)
	release
	end
}

script SecondChallengeRoom_MoveRelearner {
	lock
	faceplayer
	message("I'm the Move Reminder.")
	waitmessage
SecondChallengeRoom_MoveRelearner_ChooseMon:
	special(ChooseMonForMoveRelearner)
	waitstate
	if (var(VAR_0x8004) != PARTY_NOTHING_CHOSEN) {
		special(IsSelectedMonEgg)
		if (var(VAR_RESULT) == FALSE) {
			if (var(VAR_0x8005) == 0) {
				message("This Pokemon cannot learn anything.")
			} else {
				special(TeachMoveRelearnerMove)
				waitstate
				if (var(VAR_0x8004) == 0) {
					goto(SecondChallengeRoom_MoveRelearner_ChooseMon)
				}
			}
		}
	}
	release
	end
}

