mapscripts SecondChallengeRoom_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		if (flag(FLAG_HIKER_CHALLENGE_DONE) != TRUE) {
			setobjectxyperm(1, 6, 4)
			turnobject(1, DIR_SOUTH)
		}
	}
	
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_HACK_GAME_STATE, 8: SecondChallengeRoom_FirstBidoofMsg
	]
}

script SecondChallengeRoom_Hiker {
	lock
	faceplayer
	if (flag(FLAG_HIKER_CHALLENGE_DONE) != TRUE) {
		if (flag(FLAG_HIKER_FIRST_ENCOUNTER_DONE) != TRUE) {
			msgbox_portrait(format("Yo. Listen, I'll make it short for all of us. As you may have already guessed, I am the second leader here. And I can't let you pass, until you beat me. I hope I've made myself clear."), FIELD_PIC_HIKER)
			msgbox_portrait(format("Be careful {PLAYER}. We don't know what we'll need to do in order to get past him."), FIELD_PIC_BIDOOF_NORMAL)
			msgbox_portrait(format("You just need to beat me in a battle, pal. Simple as that."), FIELD_PIC_HIKER)
			msgbox_portrait(format("Oh, it looks like it'll be simpler this time around then."), FIELD_PIC_BIDOOF_NORMAL)
			msgbox_portrait(format("Let's beat this guy, {PLAYER}!"), FIELD_PIC_BIDOOF_SMIRKY)
			setflag(FLAG_HIKER_FIRST_ENCOUNTER_DONE)
			goto(SecondChallengeRoom_HikerBattle)
		} else {
			msgbox_portrait("It's you again.\pYou wanna try one more time?", FIELD_PIC_HIKER, MSGBOX_YESNO)
			if (var(VAR_RESULT) == YES) {
				goto(SecondChallengeRoom_HikerBattle)
			}
		}
	} 
	else {
		msgbox_portrait(format("Good luck on your journey, you'll need it."), FIELD_PIC_HIKER)
	}
	release
	end
}

script SecondChallengeRoom_HikerBattle {
	waitmessage
	closemessage
	trainerbattle_no_intro(TRAINER_HIKER_CHALLENGE, 0)
	getbyte(gBattleOutcome, VAR_RESULT)
	if (var(VAR_RESULT) == B_OUTCOME_LOST) {
		msgbox_portrait(format("You lost, punk.\pYou need stronger Pokemon, if you want to defeat me."), FIELD_PIC_HIKER)
		msgbox_portrait(format("Ow…Don't worry, {PLAYER}! I'm sure you'll beat this guy. Look around the place, try to find new Pokemon and come with a better plan next time!\pFor now, let's get your Party members healed."), FIELD_PIC_BIDOOF_NORMAL)
		waitmessage
		closemessage
		special(HealPlayerParty)
		getplayerxy(VAR_0x8004, VAR_0x8005)
		if (var(VAR_0x8004) == 7 && var(VAR_0x8005) == 4) {
			applymovement(OBJ_EVENT_ID_PLAYER, Movement_PlayerToNurse3)
		} elif (var(VAR_0x8004) == 5 && var(VAR_0x8005) == 4) {
			applymovement(OBJ_EVENT_ID_PLAYER, Movement_PlayerToNurse2)
		} else {
			applymovement(OBJ_EVENT_ID_PLAYER, Movement_PlayerToNurse1)
		}
		delay(10)
		waitmovement(0)
		playfanfare(FANFARE_HEAL)
		msgbox_portrait(format("I'll give you a tip, {PLAYER}. Check out the area south from here. I'm sure you'll be be able to train and catch new Pokemon there. Courage!"), FIELD_PIC_BIDOOF_NORMAL)
	} else {
		setflag(FLAG_HIDE_SUICUNE)
		setflag(FLAG_HIKER_CHALLENGE_DONE)
		msgbox_portrait(format("NANI?!\pWell, as much as it hurts me to say, you did win. You earned this, punk."), FIELD_PIC_HIKER)
		message("{PLAYER} received the Hiker Badge.")
		waitmessage
		call(Common_EventScript_PlayGymBadgeFanfare)
		setflag(FLAG_BADGE02_GET)
		msgbox_portrait(format("You can proceed further now. I won't block the way."), FIELD_PIC_HIKER)
		waitmessage
		closemessage
		applymovement(1, Movement_HikerNotBlocking)
		waitmovement(0)
		setobjectxyperm(1, 4, 5)
		msgbox_portrait(format("Wow! You're amazing, {PLAYER}!"), FIELD_PIC_BIDOOF_HAPPY)
		msgbox_portrait(format("This is your second Badge, now! I'm not sure if you'll need to obtain all 8 of them, but even then, it shouldn't be much of a problem for you! If you want to, you can look around the area, and then let's continue forward."), FIELD_PIC_BIDOOF_NORMAL)
	}
	release
	end
}

movement Movement_HikerNotBlocking {
	walk_down
	walk_left * 2
	face_right
	step_end
}

movement Movement_PlayerToNurse1 {
	walk_down * 8
	walk_right
	walk_down * 3
	walk_left * 3
	walk_up
	walk_left * 2
	step_end
}

movement Movement_PlayerToNurse2 {
	walk_down * 9
	walk_right * 2
	walk_down * 3
	walk_left * 3
	walk_up
	walk_left * 2
	step_end
}

movement Movement_PlayerToNurse3 {
	walk_down * 12
	walk_left * 3
	walk_up
	walk_left * 2
	step_end
}

script SecondChallengeRoom_FirstBidoofMsg {
	lock
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Up)
	waitmovement(0)
	msgbox_portrait(format("Looks like we've entered another transition cave. And this time, it is actually a cave. Let's keep our eyes open. Who knows what we'll find here."), FIELD_PIC_BIDOOF_NORMAL)
	setvar(VAR_HACK_GAME_STATE, 9)
	waitmessage
	closemessage
	release
	end
}

script SecondChallengeRoom_NurseJoy {
	lock
	faceplayer
	msgbox(format("I'll heal your Pokemon."))
	playfanfare(FANFARE_HEAL)
	special(HealPlayerParty)
	applymovement(2, Movement_PkmnCenterNurse_Bow)
	waitmovement(0)
	waitmessage
	waitfanfare
	release
	end
}

script SecondChallengeRoom_MartGuy {
	lock
	faceplayer
	message("I sell items.")
	waitmessage
	pokemart(SecondChallengeRoom_Mart)
	release
	end
}

script SecondChallengeRoom_MoveRelearner {
	lock
	faceplayer
	message("I'm the Move Reminder.\p")
	waitmessage
	closemessage
SecondChallengeRoom_MoveRelearner_ChooseMon:
	special(ChooseMonForMoveRelearner)
	waitstate
	if (var(VAR_0x8004) != PARTY_NOTHING_CHOSEN) {
		special(IsSelectedMonEgg)
		if (var(VAR_RESULT) == FALSE) {
			if (var(VAR_0x8005) == 0) {
				message("This Pokemon cannot learn anything.")
			} else {
				special(TeachMoveRelearnerMove)
				waitstate
				if (var(VAR_0x8004) == 0) {
					goto(SecondChallengeRoom_MoveRelearner_ChooseMon)
				}
			}
		}
	}
	release
	end
}

