mapscripts WingullHouseBetweenCavesInUnderwater_MapScripts {
	// Metatile changes with the blender machine
	MAP_SCRIPT_ON_LOAD {
		if (flag(FLAG_WINGULL_BLENDER_BEATEN) == TRUE) {
			setmetatile(2, 2, 0x221, FALSE) // Wall shadow
			setmetatile(2, 3, 0x2DD, TRUE) // Blender machine
		}
	}
	// removes invisible ninja objects
	MAP_SCRIPT_ON_TRANSITION {
		if (flag(FLAG_WINGULL_BLENDER_BEATEN) == TRUE) {
			setobjectxyperm(3, 13, 0)
		} else {
			setobjectxyperm(4, 13, 0)
		}
	}
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_HACK_GAME_STATE, 3: WingullHouseBetweenCavesInUnderwater_WeMadeit
	]
}

script WingullHouseBetweenCavesInUnderwater_WeMadeit {
	lock
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Up)
	waitmovement(0)
	msgbox_portrait(format("Whew, we did it!\pNice thinking with the rock-switch, {PLAYER}!"), FIELD_PIC_BIDOOF_NORMAL)
	msgbox_portrait(format("Though…We were underwater and now we're inside…a house? Talk about ambient change. This whole area is so messed up, {PLAYER}. It could be some sort of illusion, or even a spell. I'm not exactly sure."), FIELD_PIC_BIDOOF_ASTONISHED)
	msgbox_portrait(format("In any case, let's explore and continue forward."), FIELD_PIC_BIDOOF_NORMAL)
	setvar(VAR_HACK_GAME_STATE, 4)
	setflag(FLAG_SYS_B_DASH)
	waitmessage
	closemessage
	end
}

script WingullHouseBetweenCavesInUnderwater_BellNotWorking {
	lock
	msgbox("There's a Bell.\nRing it?", MSGBOX_YESNO)
	if (var(VAR_RESULT) == 1) {
		msgbox("The Bell is broken.")
	} else {
		msgbox("You left the bell untouched.")
	}
	release
	end
}

script WingullHouseBetweenCavesInUnderwater_CallWingull {
	lock
	if (flag(FLAG_WINGULL_BLENDER_BEATEN) == FALSE) {
		msgbox("There's a Bell.\nRing it?", MSGBOX_YESNO)
		if (var(VAR_RESULT) == 1) {
			msgbox("{PLAYER} rang the bell.")
			playse(SE_BIKE_BELL)
			waitse
			playse(SE_M_HEAL_BELL)
			waitse
			playse(SE_BIKE_BELL)
			waitse
			delay(30)
			msgbox_portrait("Hmm…Let's try again.", FIELD_PIC_BIDOOF_NORMAL)
			closemessage
			playse(SE_M_HEAL_BELL)
			waitse
			playse(SE_BIKE_BELL)
			waitse
			msgbox_portrait(format("You know, I would expect something to happen."), FIELD_PIC_BIDOOF_NORMAL)
			closemessage
			fadeoutbgm(3)
			callnative(FadeAllExceptBg0AndMugshots)
			delay(30)
			msgbox_portrait(format("{PLAYER}!\pGolly, it got dark all of a sudden!"), FIELD_PIC_BIDOOF_ASTONISHED)
			closemessage
			playse(SE_THUNDER)
			callnative(RemoveFollowingPokemon)
			clearflag(FLAG_BIDOOF_FOLLOWER) // Hack, we'll use OW Bidoof
			waitse
			playse(SE_THUNDER2)
			waitse
			msgbox_portrait("Did you hear that?", FIELD_PIC_BIDOOF_ASTONISHED)
			closemessage
			playse(SE_THUNDER)
			playse(SE_THUNDER)
			msgbox("WHO?!")
			delay(30)
			waitmessage
			msgbox("Who is it…")
			playse(SE_THUNDER)
			delay(20)
			msgbox("SPEAK!")
			waitmessage
			msgbox_portrait(format("We didn't want to disturb you, I swear! We actually want to leave!"), FIELD_PIC_BIDOOF_ASTONISHED)
			closemessage
			msgbox("W{PAUSE 30}A{PAUSE 30}I{PAUSE 30}T!")
			waitmessage
			msgbox(format("I can't let you {PAUSE 20}go that easily…"))
			waitmessage
			msgbox_portrait("Golly!", FIELD_PIC_BIDOOF_ASTONISHED)
			closemessage
			msgbox("T{PAUSE 10}u{PAUSE 20}r{PAUSE 30}n a{PAUSE 25}r{PAUSE 28}o{PAUSE 22}u{PAUSE 22}n{PAUSE 22}d.")
			applymovement(OBJ_EVENT_ID_PLAYER, Movement_LookDown)
			addobject(1) // Wingull
			clearflag(FLAG_HIDE_WINGULL)
			turnobject(1, DIR_NORTH)
			addobject(2) // Bidoof
			setobjectxy(1, 7, 5)
			fadeinbgm(3)
			callnative(FadeOutAllExceptBg0AndMugshots)
			delay(5)
			msgbox_portrait("Hey y'all! I'm Wingull!\nWingull, the gull!", FIELD_PIC_WINGULL)
			msgbox_portrait("…\pReally?\lTalk about anticlamatic…", FIELD_PIC_BIDOOF_ASTONISHED)
			msgbox_portrait("Hmm? You were sayin'?", FIELD_PIC_WINGULL)
			msgbox_portrait("Golly, no! Nothing!", FIELD_PIC_BIDOOF_ASTONISHED)
			msgbox_portrait(format("Welcome in my humble domain!\nThe rules are simple: if you wish to pass, you'll need to defeat me in a duel!"), FIELD_PIC_WINGULL)
			msgbox_portrait("Duel?", FIELD_PIC_BIDOOF_ASTONISHED)
			msgbox_portrait(format("Yes! It's time to du-du-du-duel!"), FIELD_PIC_WINGULL)
			closemessage
			setwildbattle(SPECIES_WINGULL, 19)
			dowildbattle
			setvar(VAR_HACK_GAME_STATE, 5)
			msgbox_portrait("Hey!\nLet me finish first!\pWe'll have a…\la…\la…\la…\la…\la…\la…\la…", FIELD_PIC_WINGULL)
			msgbox_portrait("Oh come on!\nSpit it out already!", FIELD_PIC_BIDOOF_ASTONISHED)
			load_field_pic(FIELD_PIC_WINGULL, MSG_PORTRAIT_X, MSG_PORTRAIT_Y, VAR_0x8008)
			msgbox_portrait("As I was saying!\pWe'll have a…\lBerry Blending duel!", FIELD_PIC_WINGULL)
			playse(SE_APPLAUSE)
			waitse
			destroy_field_pic(FIELD_PIC_WINGULL, VAR_0x8008)
			msgbox_portrait(format("Right, exactly what I had in mind…"), FIELD_PIC_BIDOOF_ASTONISHED)
			msgbox_portrait("Follow me!", FIELD_PIC_WINGULL)
			closemessage
			applymovement(1, MovementToBlenderWingull)
			applymovement(OBJ_EVENT_ID_PLAYER, MovementToBlenderPlayer)
			applymovement(2, MovementToBlenderBidoof)
			waitmovement(0)
			msgbox_portrait(format("Alright! There's three of us, so that's even better. I was hoping for a quartet, but whatever.\lTHE RULES!\lThe rules are fairly simple, you just need the right equipment. Which you are missing, but fear not! I have a spare Pokeblock Case and some berries. Here!"), FIELD_PIC_WINGULL)
			closemessage
			giveitem(ITEM_POKEBLOCK_CASE, 1)
			giveitem(ITEM_ORAN_BERRY, 31)
			msgbox_portrait("Now we're ready!", FIELD_PIC_WINGULL)
			msgbox_portrait("What about the rules?", FIELD_PIC_BIDOOF_NORMAL)
			msgbox_portrait("Rules? You want me to explain\nthe rules?", FIELD_PIC_WINGULL, MSGBOX_YESNO)
			if (var(VAR_RESULT) == 1) {
				msgbox_portrait(format("Well, ugh…\nYou throw a Berry and then the thing spins…I'm sure you'll quickly get the hang of it!"), FIELD_PIC_WINGULL)
				msgbox_portrait("For sure…", FIELD_PIC_BIDOOF_ASTONISHED)
			} else {
				msgbox_portrait("Yeah, I'm sure you already know them!", FIELD_PIC_WINGULL)
			}
			msgbox_portrait("Let's go!", FIELD_PIC_WINGULL)
			closemessage
			setvar(VAR_0x8004, 2)
			fadescreen(FADE_TO_BLACK)
			special(DoBerryBlending)
			waitstate
			playbgm(MUS_LINK_CONTEST_P1, FALSE) // For some reason the music changes
			callnative(BerryBlenderGetLostCount)
			switch (var(VAR_RESULT)) {
			case 0: msgbox_portrait(format("Wow! You beat me on the first try! You're like a Berry Blending Master!"), FIELD_PIC_WINGULL)
			case 1: msgbox_portrait(format("Wow, you're pretty good! It only took you 2 attempts to beat me!"), FIELD_PIC_WINGULL)
			case 2: msgbox_portrait(format("You're good, I'll give you that!"), FIELD_PIC_WINGULL)
			case 3: msgbox_portrait(format("It took you 4 tries, but you've got it. Grats!"), FIELD_PIC_WINGULL)
			case 4: msgbox_portrait(format("You got me, not bad!"), FIELD_PIC_WINGULL)
			case 5: case 6: case 7: case 8: case 9: case 10: case 11: case 12: case 13: msgbox_portrait(format("You did it champ! It took you long enough, but you beat me fair and square."), FIELD_PIC_WINGULL)
			default: msgbox_portrait(format("Well…Every streak has to end, mine too! As for you, I fell like you'll have enough Berry Blending for quite some time, haha!"), FIELD_PIC_WINGULL)
			}
			message("{PLAYER} received the Blender Badge\nfrom Wingull.")
			waitmessage
			call(Common_EventScript_PlayGymBadgeFanfare)
			setflag(FLAG_BADGE01_GET)
			setflag(FLAG_WINGULL_BLENDER_BEATEN)
			msgbox_portrait(format("You earned it, champ!"), FIELD_PIC_WINGULL)
			msgbox_portrait(format("Oh, I see {PLAYER}!\nIf things were normal, you would've received a Badge only after beating a Gym leader! I believe there are 8 Gym Leaders you need to beat, before facing the ultimate challenge. Or something similar, I'm not 100% sure.\l…\lGiven the actual state of affairs here, you'll probably obtain the badges in other, weirder ways, just like here with Wingull."), FIELD_PIC_BIDOOF_NORMAL)
			msgbox_portrait(format("Golly! I struggle to think what the next 'Gym Leader' will be like!"), FIELD_PIC_BIDOOF_ASTONISHED)
			msgbox_portrait(format("That's how things work here in the Underwater.\lThough, Bidoof. Out of everyone, you should've known that already.\lAfter all…"), FIELD_PIC_WINGULL)
			msgbox_portrait(format("What are you even talking about!? Whatever, {PLAYER} won, which means we can leave."), FIELD_PIC_BIDOOF_ASTONISHED)
			msgbox_portrait(format("I was hoping you'd stay here for a bit longer! But it's fine! Let me move this thing…"), FIELD_PIC_WINGULL)
			closemessage
			applymovement(1, MovementOneDown)
			setmetatile(2, 2, 0x221, FALSE) // Wall shadow
			setmetatile(2, 3, 0x2DD, TRUE) // Blender machine
			setobjectxy(3, 13, 0)
			setobjectxy(4, 2, 3)
			setobjectxyperm(4, 2, 3)
			special(DrawWholeMapView)
			waitmovement(0)
			msgbox_portrait(format("Much better!\pI'm not going anywhere, so if you need something, just let me know!\lSmell ya later!"), FIELD_PIC_WINGULL)
			applymovement(1, MovementWingullFromBlender)
			msgbox_portrait(format("Alright, {PLAYER}! Let's get out of here!"), FIELD_PIC_BIDOOF_NORMAL)
			waitmessage
			closemessage
			waitmovement(0)
			applymovement(2, MovementBidoofLeft)
			waitmovement(0)
			setflag(FLAG_BIDOOF_FOLLOWER)
			callnative(UpdateFollowingPokemon)
			removeobject(2)
			applymovement(OBJ_EVENT_ID_PLAYER, MovementPlayerFaceUp_WingullHouse)
			waitmovement(0)
			delay(2)
			setvar(VAR_HACK_GAME_STATE, 6)
		} else {
			msgbox("You left the bell untouched.")
		}
	} else {
		if (var(VAR_HACK_GAME_STATE) == 6) {
			msgbox_portrait(format("Thanks for playing with me! I'm sure we'll see each other again!"), FIELD_PIC_WINGULL)
		} elif (flag(FLAG_HIKER_CHALLENGE_DONE) == TRUE && flag(FLAG_WINGULL_COMMENTARY_HIKER) == FALSE) {
			msgbox_portrait(format("I see you've beaten that Hiker asshole! Nicely done. Seriously, screw him.\pThanks for stepping by and sharing the news with me!"), FIELD_PIC_WINGULL)
			setflag(FLAG_WINGULL_COMMENTARY_HIKER)
		}		
		else {
			msgbox_portrait(format("Hey guys! Nice to see you again!"), FIELD_PIC_WINGULL)
		}
	}
	release
	end
}

movement MovementPlayerFaceUp_WingullHouse {
	walk_down
	face_up
	step_end
}

movement MovementBidoofLeft {
	walk_left
	walk_left
	face_down
	step_end
}

movement MovementWingullFromBlender {
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_up
	walk_up
	face_down
	step_end
}

movement MovementOneDown {
	walk_down
	step_end
}

movement MovementToBlenderWingull {
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_up
	walk_up
	step_end
}

movement MovementToBlenderPlayer {
	delay_16
	delay_16
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_up
	walk_up
	face_right
	step_end
}

movement MovementToBlenderBidoof {
	delay_16
	delay_16
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_up
	walk_up
	face_left
	step_end
}

script WingullHouseBetweenCavesInUnderwater_BerryBlenderMachine {
	lockall
	msgbox("It's a Berry Blender.\nIt can't be used at the moment.")
	releaseall
	end
}

movement Movement_LookDown {
	face_down
	step_end
}

movement Movement_Up {
	walk_up
	face_down
	step_end
}

movement Movement_LookUpWingull {
	face_up
	step_end
}

