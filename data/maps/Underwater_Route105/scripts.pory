mapscripts Underwater_Route105_MapScripts {
	MAP_SCRIPT_ON_RESUME: Script_Underwater_Route105_OnResume
	MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_HACK_GAME_STATE, 14: Script_UnderwaterRoute105_SaveGame
    ]
	MAP_SCRIPT_ON_LOAD {
		if (var(VAR_HACK_GAME_STATE) >= 13) {
			// Block north exit
			setmetatile(20, 51, 0x21B, TRUE)
			setmetatile(20, 50, 0x21B, TRUE)
			setmetatile(54, 75, 0x22F, TRUE)
			// Unlock path south
			setmetatile(21, 59, 0x2A9, FALSE)
			setmetatile(20, 60, 0x2A9, FALSE)
			setmetatile(21, 60, 0x2A9, FALSE)
			setmetatile(21, 61, 0x2A9, FALSE)
			// For better look
			setmetatile(20, 58, 0x27E, TRUE)
			setmetatile(20, 59, 0x286, TRUE)
			setmetatile(19, 60, 0x286, TRUE)
			setmetatile(20, 61, 0x27E, TRUE)
		}
	}
}

script Script_Underwater_Route105_OnResume {
	call(AbnormalWeather_Underwater_SetupEscapeWarp)
	end
}

script Script_UnderwaterRoute105_SaveGame {
	lock
	setvar(VAR_HACK_GAME_STATE, 15)
	msgbox("WAIT...")
	callnative(ScrCmd_SaveGame)
	closemessage
	release
	end
}

script Underwater_Route105_Sign1 {
	if (var(VAR_HACK_GAME_STATE) >= 15) {
		random(5)
		switch (var(VAR_RESULT)) {
			case 0: msgbox("C'est un panneau.", MSGBOX_SIGN)
			case 1: msgbox("Questo è un cartello.", MSGBOX_SIGN)
			case 2: msgbox("Esto es una señal.", MSGBOX_SIGN)
			case 3: msgbox("This is a signpost.", MSGBOX_SIGN)
			case 4: msgbox("German: TODO.", MSGBOX_SIGN)
		}
	}
	else {
		random(5)
		switch (var(VAR_RESULT)) {
			case 0: msgbox("C'est PAS un panneau.", MSGBOX_SIGN)
			case 1: msgbox("Questo NON è un cartello.", MSGBOX_SIGN)
			case 2: msgbox("Esto NO es una señal.", MSGBOX_SIGN)
			case 3: msgbox("This is NOT a signpost.", MSGBOX_SIGN)
			case 4: msgbox("German: TODO.", MSGBOX_SIGN)
		}
	}
}
